# Optional per-app overrides. The monorepo reads the root .env first
# (see next.config.mjs → scripts/dotenv.mjs); anything set here wins over it.

# Port this app listens on.
STAFF_PORT=3001
# Where /api/v1/* is proxied to by the Next.js dev/prod server.
API_PROXY_TARGET=http://127.0.0.1:3000
# Leave EMPTY to call the API through this app's own origin (recommended: no CORS,
# works from any host). Set an absolute URL only for a split deployment.
NEXT_PUBLIC_API_BASE_URL=
# Cross-surface bases (empty = same origin). Set these in a split-domain deploy.
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_PLATFORM_URL=

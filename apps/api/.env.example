# OPTIONAL per-app overrides.
#
# The API now loads the ROOT `.env` automatically (packages/config/src/load-env.ts).
# Start there:  pnpm env:setup   →  writes <repo>/.env with generated keys.
#
# Only create `apps/api/.env` when one machine needs to differ from the root file;
# values here take precedence over the root, and real environment variables win over
# both. Never commit real secrets.

NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0

# PostgreSQL — must be a NOBYPASSRLS application role (see MULTI_TENANCY.md §3)
DATABASE_URL=postgres://erp_api:app-dev-password@localhost:5432/app
DATABASE_POOL_MAX=10
DATABASE_APP_ROLE=erp_api
DATABASE_MIGRATOR_ROLE=erp_migrator
# Superuser/owner URL used only by `pnpm db:migrate` (offline, never at runtime)
DATABASE_MIGRATOR_URL=postgres://app:app-dev-password@localhost:5432/app
# Used only by `pnpm db:roles` to grant LOGIN to the two roles above.
DATABASE_APP_PASSWORD=app-dev-password
DATABASE_MIGRATOR_PASSWORD=

REDIS_URL=redis://localhost:6379

# RS256 key pair (PEM). Generate for dev with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev-key-1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Argon2id parameters (frozen by PROJECT_CONTRACT §9 / SECURITY_ARCHITECTURE §2)
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=4
AUTH_ARGON2_OUTPUT_LENGTH=32
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15

RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
# P-M6 — استمارات الموقع العامّة (تواصل · طلب عرض · نشرة): دلوٌ مستقلّ بحدٍّ منخفض.
RATE_LIMIT_PUBLIC_FORM_PER_MINUTE=10
# P-M7 — دلوُ زحف الحملات (بكسل الفتح والنقر وإلغاء الاشتراك): عملاء البريد تحمّل البكسل
# آليّاً، فسقفُ الاستمارات يقطع حملةً حقيقية. الكتابة محدودة بالفهارس الفريدة لكل حدث.
RATE_LIMIT_CAMPAIGN_TRACK_PER_MINUTE=120
# P-M8 — دلوُ التحقّق العام (POST /public/verify): قراءةٌ لا كتابة، ومستقلٌّ عن الاستمارات.
RATE_LIMIT_PUBLIC_VERIFY_PER_MINUTE=30
# P-M9 — دلوُ صفحة حالة الخدمة (GET /public/status): كل نداءٍ يقرأ المجسّات، وفوقه ذاكرةُ ١٠ث.
RATE_LIMIT_PUBLIC_STATUS_PER_MINUTE=60
# P-M10 — أحداث الموقع التسويقي (POST /public/events): دفعاتٌ مجهولة الهوية بعد موافقة الزائر.
RATE_LIMIT_PUBLIC_EVENTS_PER_MINUTE=120
# Public self-service signup window (POST /api/v1/signup). Set to false for a private deployment.
SIGNUP_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
OPENAPI_ENABLED=true

# Object storage (MinIO in docker-compose). All four are required before any file
# endpoint can mint a pre-signed URL; the API still boots without them.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=erp-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECONDS=900

# Files (PHASE_04 §5.3)
FILES_MAX_UPLOAD_BYTES=26214400
# Comma-separated allow-list; anything else is rejected at presign time.
# FILES_ALLOWED_MIME_TYPES=image/png,image/jpeg,application/pdf,text/csv
FILES_DOWNLOAD_URL_TTL_SECONDS=300
FILES_ORPHAN_GC_HOURS=24

# Purchase-invoice OCR (set OCR_PROVIDER=mock only for deterministic verification)
OCR_PROVIDER=http
# OCR_ENDPOINT=https://ocr.example.internal/extract
# OCR_API_KEY=replace-with-deployment-secret
OCR_TIMEOUT_MS=60000
# MOYASAR_API_BASE=https://api.moyasar.com/v1
# Accounting assistant fallback when the platform has not stored a key.
# AI_PROVIDER=local
# AI_API_KEY=
# TAP_API_BASE=https://api.tap.company/v2
# HYPERPAY_API_BASE=https://eu-prod.oppwa.com
# APP_PUBLIC_URL=https://app.example.com
# API_PUBLIC_URL=https://api.example.com

# Background jobs (PHASE_04 §5.5). WORKER=1 starts the worker role instead of the HTTP
# API — same image, same DI graph, no listener. Without REDIS_URL the queue driver is
# inert: outbox rows accumulate as `pending` and nothing is lost.
WORKER=0
JOBS_ENABLED=true
JOB_QUEUE_PREFIX=erp
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_BASE_MS=2000
WORKER_HEALTH_LOG_INTERVAL_MS=60000

# Idempotency-Key storage (DATABASE_DESIGN §4: "expires 24h")
IDEMPOTENCY_TTL_HOURS=24

# Mail — `console` logs the message; `smtp` targets MailHog locally (port 1025).
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@erp.local
SMTP_HOST=localhost
SMTP_PORT=1025

# AES-256-GCM data-encryption key (32 bytes, base64) — SECURITY_ARCHITECTURE §9
DATA_ENC_KEY=
# HMAC secret for app-signed download URLs. Derived from DATA_ENC_KEY when left empty;
# set it explicitly in production so links survive a key rotation of the other secret.
FILE_URL_SIGNING_SECRET=

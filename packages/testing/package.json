{
  "name": "@erp/testing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/test-database.d.ts",
      "default": "./dist/test-database.js"
    },
    "./isolation": {
      "types": "./dist/isolation-suite.d.ts",
      "default": "./dist/isolation-suite.js"
    },
    "./factories": {
      "types": "./dist/factories.d.ts",
      "default": "./dist/factories.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@erp/config": "workspace:*",
    "@erp/database": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "embedded-postgres": "16.14.0-beta.17",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "lint": "eslint src --config ../../eslint.config.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

# =============================================================================
# Cloud SaaS ERP — single root environment file.
#
#   cp .env.example .env      (or, better: pnpm env:setup — it also mints the keys)
#
# Every workspace app reads this file: the API through @erp/config, the four Next.js
# apps through scripts/dotenv.mjs in their next.config.mjs. A variable that already
# exists in the real process environment always wins over anything written here.
# An app-local apps/<name>/.env overrides this file.
# =============================================================================

NODE_ENV=development

# ---------------------------------------------------------------- API (apps/api)
PORT=3000
API_HOST=0.0.0.0

# ---------------------------------------------------------------- Web apps
# Port each Next.js app listens on.
STAFF_PORT=3001
MARKETING_PORT=3002
PLATFORM_ADMIN_PORT=3003
CUSTOMER_PORTAL_PORT=3004
# Where the Next.js dev server proxies /api/v1/* to. Browsers never talk to the API
# directly, so this may stay on localhost even when the UI is opened from another host.
API_PROXY_TARGET=http://127.0.0.1:3000
# Absolute origins of the web surfaces, used in Stripe redirects and emails.
PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_STAFF_URL=http://localhost:3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3004
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3003
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Leave empty to use the same-origin proxy (recommended). Set it only when the browser
# must reach a different API origin, and add that origin to CORS_ALLOWED_ORIGINS too.
NEXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------- PostgreSQL
# Must be a NOBYPASSRLS application role (MULTI_TENANCY.md §3).
DATABASE_URL=postgres://erp_api:app-dev-password@localhost:5432/app
DATABASE_POOL_MAX=10
DATABASE_APP_ROLE=erp_api
DATABASE_MIGRATOR_ROLE=erp_migrator
# Owner URL used only by `pnpm db:migrate` / `pnpm db:seed`, never at runtime.
DATABASE_MIGRATOR_URL=postgres://app:app-dev-password@localhost:5432/app
# Used only by `pnpm db:roles` to grant LOGIN to the two roles above.
DATABASE_APP_PASSWORD=app-dev-password
DATABASE_MIGRATOR_PASSWORD=app-dev-password

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- Auth / JWT
# RS256 PEM pair. `pnpm env:setup` generates them; to do it by hand:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Paste as a single double-quoted line with \n escapes, or as a quoted multi-line block.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev-key-1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Argon2id parameters (frozen by PROJECT_CONTRACT §9 / SECURITY_ARCHITECTURE §2)
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=4
AUTH_ARGON2_OUTPUT_LENGTH=32
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15

RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
# Public self-service signup window (POST /api/v1/signup). Set to false for a private deployment.
SIGNUP_ENABLED=true

# Only needed when a browser calls the API cross-origin (i.e. NEXT_PUBLIC_API_BASE_URL
# points at a different host). With the same-origin proxy this can stay as-is.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
OPENAPI_ENABLED=true

# ---------------------------------------------------------------- Object storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=erp-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECONDS=900

FILES_MAX_UPLOAD_BYTES=26214400
FILES_DOWNLOAD_URL_TTL_SECONDS=300
FILES_ORPHAN_GC_HOURS=24

# Purchase-invoice OCR (set OCR_PROVIDER=mock only for deterministic verification)
OCR_PROVIDER=http
# OCR_ENDPOINT=https://ocr.example.internal/extract
# OCR_API_KEY=replace-with-deployment-secret
OCR_TIMEOUT_MS=60000
# Online payment links (Moyasar / Tap / HyperPay). Leave bases empty for the vendor defaults.
# MOYASAR_API_BASE=https://api.moyasar.com/v1
# Accounting assistant. local answers from tenant aggregates without a model key.
# AI_PROVIDER=local
# AI_MODEL=
# AI_BASE_URL=
# Employee mobile Web Push. Empty keeps notices in the in-app outbox.
# WEB_PUSH_VAPID_PUBLIC=
# WEB_PUSH_VAPID_PRIVATE=
# AI_API_KEY=
# TAP_API_BASE=https://api.tap.company/v2
# HYPERPAY_API_BASE=https://eu-prod.oppwa.com
# APP_PUBLIC_URL=https://app.example.com
# API_PUBLIC_URL=https://api.example.com

# P-C10: where a platform backup is written when object storage is not configured.
BACKUP_ARTIFACT_DIR=/tmp/erp-backups
BACKUP_STORE=auto

# ---------------------------------------------------------------- Background jobs
WORKER=0
JOBS_ENABLED=true
JOB_QUEUE_PREFIX=erp
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_BASE_MS=2000
WORKER_HEALTH_LOG_INTERVAL_MS=60000

IDEMPOTENCY_TTL_HOURS=24

# ---------------------------------------------------------------- Mail
# console = log messages only; smtp = deliver (MailHog: host localhost, port 1025).
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@erp.local
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional AUTH LOGIN credentials (MailHog needs none).
SMTP_USER=
SMTP_PASS=
# true = implicit TLS on connect (port 465 style); otherwise STARTTLS when advertised.
SMTP_SECURE=false
# Public URL of apps/customer, printed inside outbound e-mails.
CUSTOMER_PUBLIC_URL=http://localhost:3002
# Public URL of the platform console, linked from the weekly report.
CONSOLE_PUBLIC_URL=http://localhost:3003

# ---------------------------------------------------------------- Secrets
# 32 random bytes, base64 (SECURITY_ARCHITECTURE §9). `pnpm env:setup` fills these in.
DATA_ENC_KEY=
FILE_URL_SIGNING_SECRET=
# Pepper for hashing legacy gateway device keys (AUD-09). Required in production;
# tests fall back to an isolated test-only value. `pnpm env:setup` fills it in.
COMPAT_KEY_PEPPER=

# ---------------------------------------------------------------- Billing (optional)
# Leave empty to use manual activation only; the platform console approves requests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Seed (`pnpm db:seed`)
# `pnpm env:setup` fills the four password variables below with strong random values.
# Any password left empty creates that account as `invited` (no way to sign in until an
# operator sets one) — the seed never invents a password silently.

# Platform operator = the super admin of the console at /platform. It belongs to the
# internal `platform` tenant, which is created by the seed.
PLATFORM_ADMIN_EMAIL=admin@platform.test
PLATFORM_ADMIN_NAME=مدير المنصة
PLATFORM_ADMIN_PASSWORD=
PLATFORM_TENANT_CODE=platform

# The demo company (tenant) and its owner.
DEMO_TENANT_CODE=demo
DEMO_TENANT_NAME=شركة تجريبية
DEMO_OWNER_EMAIL=owner@demo.test
DEMO_OWNER_NAME=مالك الحساب
DEMO_OWNER_PASSWORD=

# Two extra members of the demo company, on the baseline Accountant / Cashier roles.
DEMO_ACCOUNTANT_EMAIL=accountant@demo.test
DEMO_ACCOUNTANT_NAME=محاسب الشركة
DEMO_ACCOUNTANT_PASSWORD=
DEMO_CASHIER_EMAIL=cashier@demo.test
DEMO_CASHIER_NAME=أمين الصندوق
DEMO_CASHIER_PASSWORD=

# Demo dataset: licence, chart of accounts, cost centres, fiscal calendar, opening entry.
# Set SEED_DEMO_DATA=false for a bare tenant (registry + roles + owner only).
SEED_DEMO_DATA=true
DEMO_PLAN_CODE=pro-monthly
DEMO_SUBSCRIPTION_MONTHS=12
DEMO_OPENING_ENTRY=true
# Calendar year of the fiscal year to create. Empty = the current year.
DEMO_FISCAL_YEAR=

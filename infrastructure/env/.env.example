# Local development environment template.
# Copy to .env (gitignored) and adjust. Never commit real secrets.

NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0

# PostgreSQL — must be a NOBYPASSRLS application role (see MULTI_TENANCY.md §3)
DATABASE_URL=postgres://erp_api:app-dev-password@localhost:5432/app
DATABASE_POOL_MAX=10
DATABASE_APP_ROLE=erp_api
DATABASE_MIGRATOR_ROLE=erp_migrator
# Superuser/owner URL used only by `pnpm db:migrate` (offline, never at runtime)
DATABASE_MIGRATOR_URL=postgres://app:app-dev-password@localhost:5432/app
# Used only by `pnpm db:roles` to grant LOGIN to the two roles above.
DATABASE_APP_PASSWORD=app-dev-password
DATABASE_MIGRATOR_PASSWORD=

REDIS_URL=redis://localhost:6379

# RS256 key pair (PEM). Generate for dev with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev-key-1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Argon2id parameters (frozen by PROJECT_CONTRACT §9 / SECURITY_ARCHITECTURE §2)
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=4
AUTH_ARGON2_OUTPUT_LENGTH=32
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15

RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
OPENAPI_ENABLED=true

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=erp-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# AES-256-GCM data-encryption key (32 bytes, base64) — SECURITY_ARCHITECTURE §9
DATA_ENC_KEY=

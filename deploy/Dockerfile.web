# ---------------------------------------------------------------------------
# الواجهات الأربع (Next.js 15) — صورةٌ واحدة تُبنى بـ`--build-arg APP=<الاسم>`:
#
#   docker build -f deploy/Dockerfile.web --build-arg APP=marketing       -t erp-marketing       .
#   docker build -f deploy/Dockerfile.web --build-arg APP=staff           -t erp-staff           .
#   docker build -f deploy/Dockerfile.web --build-arg APP=platform-admin  -t erp-platform-admin  .
#   docker build -f deploy/Dockerfile.web --build-arg APP=customer-portal -t erp-customer-portal .
#
# التطبيقات تُبنى بـ`output: 'standalone'` (انظر `apps/*/next.config.mjs`)، فصورة التشغيل
# تحمل الخادم المُصغَّر فقط + `.next/static` + `public` — لا مساحة عمل ولا اعتماديات تطوير.
#
# متغيّرات البناء (`--build-arg`): `NEXT_PUBLIC_API_BASE_URL` (واجهة الـAPI كما يراها
# **المتصفح**) — اتركها فارغةً إن كان الخادم يمرّر `/api/v1/*` عبر `rewrites` (الوضع
# الافتراضي في `docker-compose.yml`، ويحتاج `API_PROXY_TARGET` على خادم Next نفسه).
# ---------------------------------------------------------------------------
ARG NODE_VERSION=22-bookworm-slim

# --- 1) البناء -----------------------------------------------------------------
FROM node:${NODE_VERSION} AS builder
ARG APP=marketing
ARG NEXT_PUBLIC_API_BASE_URL=""
ARG API_PROXY_TARGET=""
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    API_PROXY_TARGET=${API_PROXY_TARGET}
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
RUN mkdir -p apps/api apps/customer-portal apps/marketing apps/migrator apps/platform-admin apps/staff \
  packages/config packages/contracts packages/database packages/testing packages/ui
COPY apps/api/package.json apps/api/package.json
COPY apps/customer-portal/package.json apps/customer-portal/package.json
COPY apps/marketing/package.json apps/marketing/package.json
COPY apps/migrator/package.json apps/migrator/package.json
COPY apps/platform-admin/package.json apps/platform-admin/package.json
COPY apps/staff/package.json apps/staff/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/testing/package.json packages/testing/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN --mount=type=cache,id=erpcloud-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --store-dir=/pnpm/store --frozen-lockfile --prefer-offline \
      --network-concurrency=4 --fetch-retries=5 --fetch-timeout=120000
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
# الحزم المشتركة أوّلاً (النوعان من التطبيقات يقرآنها في وقت البناء)، ثم التطبيق المطلوب.
RUN pnpm --filter "./packages/*" run build
RUN pnpm --filter "@erp/${APP}" run build

# --- 2) التشغيل ----------------------------------------------------------------
FROM node:${NODE_VERSION} AS runtime
ARG APP=marketing
ARG PORT=3000
ENV NODE_ENV=production \
    APP=${APP} \
    PORT=${PORT} \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# `standalone` يُخرج شجرةً مستقلة تحت `.next/standalone` وفيها `node_modules` المطلوبة.
COPY --from=builder /repo/apps/${APP}/.next/standalone ./
COPY --from=builder /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
# لا مجلّد `public/` في هذه التطبيقات اليوم (الأيقونات تُبنى في `app/`)، فإن أُضيف لاحقاً
# يكفي إضافة السطر التالي بعد إنشائه:
# COPY --from=builder /repo/apps/${APP}/public ./apps/${APP}/public

RUN useradd --system --uid 10001 --create-home erp && chown -R erp:erp /app
USER erp

EXPOSE ${PORT}
HEALTHCHECK --interval=20s --timeout=5s --start-period=25s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"

# الخادم المُصغَّر يستمع على `PORT` و`HOSTNAME` من البيئة (سلوك Next standalone).
# صيغة shell عن قصد: `CMD` بالصيغة التنفيذية لا تُستبدل فيها متغيّرات البيئة، و`APP` متغيّرُ
# بيئةٍ هنا، فتُقرأ وقت التشغيل.
CMD node apps/${APP}/server.js
